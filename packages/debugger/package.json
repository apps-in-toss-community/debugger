{
  "name": "@ait-co/debugger",
  "version": "0.1.0",
  "description": "MCP debugging daemon, on-device CDP relay, test runner, and dev bridge for Apps in Toss mini-apps — devDependency / npx tooling, never part of a production bundle",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "debugger": "./dist/mcp/cli.js",
    "debugger-test": "./dist/test-runner/bin.js"
  },
  "exports": {
    "./mcp/server": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./mcp/cli": {
      "types": "./dist/mcp/cli.d.ts",
      "import": "./dist/mcp/cli.js"
    },
    "./test-runner": {
      "types": "./dist/test-runner/config.d.ts",
      "import": "./dist/test-runner/config.js"
    },
    "./dev-bridge": {
      "types": "./dist/dev-bridge/index.d.ts",
      "import": "./dist/dev-bridge/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@ait-co/internal-protocol": "workspace:*",
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.6.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "mini-app",
    "debugger",
    "mcp",
    "cdp",
    "relay",
    "test-runner",
    "devtools"
  ],
  "packageManager": "pnpm@10.33.0",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apps-in-toss-community/debugger",
    "directory": "packages/debugger"
  },
  "homepage": "https://www.npmjs.com/package/@ait-co/debugger",
  "bugs": {
    "url": "https://github.com/apps-in-toss-community/debugger/issues"
  }
}
